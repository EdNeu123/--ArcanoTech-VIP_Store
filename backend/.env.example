# ── Mercado Pago ─────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional, mas recomendado: painel do Mercado Pago > Webhooks > Assinatura secreta
MP_WEBHOOK_SECRET=

# ── Identidade do servidor Minecraft atendido por este deploy ──
# Precisa bater com "server_id" no webstore.toml do EasyVip
EASYVIP_SERVER_ID=arcanotech

# ── Autenticação do EasyVip (fulfillment) ───────────────────────
# Bearer token que o EasyVip manda no header Authorization
EASYVIP_BEARER_TOKEN=gere-um-token-longo-e-aleatorio-aqui

# Mapa keyId -> segredo HMAC, em JSON (permite rotacionar chaves).
# Precisa bater com [fulfillment.keys.<key_id>] no webstore.toml do EasyVip.
EASYVIP_HMAC_KEYS={"easyvip-arcanotech-v1":"gere-um-segredo-longo-e-aleatorio-aqui"}

# Tolerância de timestamp (segundos) — mesmo valor configurado no EasyVip
EASYVIP_TIMESTAMP_TOLERANCE_SECONDS=60

# Duração do lease de um claim antes de voltar pro pool (segundos)
EASYVIP_LEASE_DURATION_SECONDS=120

# Limites do /claim
EASYVIP_CLAIM_DEFAULT_LIMIT=20
EASYVIP_CLAIM_MAX_LIMIT=100

# ── Firebase Admin (Firestore) ──────────────────────────────────
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço
# > Gerar nova chave privada
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# Cole a private_key inteira, com as quebras de linha como \n literais
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExxxxx...\n-----END PRIVATE KEY-----\n"
